# Vision Guard - root web hardening
Options -Indexes
RewriteEngine On

# Force HTTPS before serving public routes.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Never serve include files or provider credentials directly.
RewriteRule ^(?:api/(?:_[^/]+|sms-config)\.php|admin/includes/.*)$ - [F,L]

# Dot-folders and dot-files are never public: .git, .github, .env, admin/.user.ini and the like.
# .well-known stays reachable because it holds the domain/SSL validation file.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]

# Block editor/backup/database/config artifacts, including dated copies such as index.php.bak-20261018,
# index.php.bak3-20261116-cap and x.bak_2026. The extension token may be followed by digits and then by
# - . _ plus anything, or end the name. The token must end at that point, so names like site.logo.png
# (".log" + "o") and app.config.js (".conf" + "ig") are not caught. A trailing ~ (editor backup) is blocked too.
<FilesMatch "(?i)(\.(?:bak|backup|old|orig|save|sql|gz|zip|log|env|ini|conf|swp|tmp|dist|inc)\d*(?:[-._].*)?$|~$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# /admin without a trailing slash must land on the admin folder (its pages use relative redirects).
RewriteRule ^admin$ /admin/ [R=301,L]

# Site pages.
RewriteRule ^(shop|planner|about|faq|contact|cart|account)/$ /$1 [R=301,L]
RewriteRule ^(shop|planner|about|faq|contact|cart|account)$ index.php?page=$1 [L,QSA]

# Existing clean routes.
RewriteRule ^p/([A-Za-z0-9-]+)/?$ product.php?s=$1 [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^c/([a-z0-9-]+)/?$ category.php?c=$1 [L,QSA]

# Compress text responses (smaller transfers; no change to content).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

AddDefaultCharset UTF-8
AddCharset UTF-8 .txt

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
  Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>

# PWA: correct manifest type, always revalidate the service worker
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
<Files "sw.js">
Header set Cache-Control "no-cache"
</Files>
</IfModule>

# Security headers
<IfModule mod_headers.c>
Header unset X-Powered-By
Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; script-src-attr 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self'; frame-src https://www.facebook.com; form-action 'self' https://wa.me; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
</IfModule>
